      "side": 1,
      "message": "Please follow the Redfish spec and pass the complete invalid header (name + value) in MessageArgs, not just \"Content-Type\".",
      "revId": "02590196acdfc8db42972e7a8a0da9b6bf4de505",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
