      "writtenOn": "2026-08-05T12:14:26Z",
      "side": 1,
      "message": "i believe that\u0027s the default behavior in bmcweb for collections, right?\n\nhttps://discordapp.com/channels/775381525260664832/1489179134960865430/1489179148290101318\n\nthere\u0027s an old comment from Ed here\nhttps://gerrit.openbmc.org/c/openbmc/bmcweb/+/88545/comment/5a6c3ba4_8ef9c741/\n\nabout unique leaf constraint\n\nAlso if we look at how the chassis collection is obtained,\n```\n  inline void requestRoutesChassisCollection(App\u0026 app) \n  {\n      BMCWEB_ROUTE(app, \"/redfish/v1/Chassis/\")\n          .privileges(redfish::privileges::getChassisCollection)\n          .methods(boost::beast::http::verb::get)(\n              std::bind_front(handleChassisCollectionGet, std::ref(app)));\n  }\n    inline void handleChassisCollectionGet(\n      App\u0026 app, const crow::Request\u0026 req,\n      const std::shared_ptr\u003cbmcweb::AsyncResp\u003e\u0026 asyncResp)\n  {\n      if (!redfish::setUpRedfishRoute(app, req, asyncResp))\n      {\n          return;\n      }\n      asyncResp-\u003eres.jsonValue[\"@odata.type\"] \u003d\n          \"#ChassisCollection.ChassisCollection\";\n      asyncResp-\u003eres.jsonValue[\"@odata.id\"] \u003d \"/redfish/v1/Chassis\";\n      asyncResp-\u003eres.jsonValue[\"Name\"] \u003d \"Chassis Collection\";\n                      \n      collection_util::getCollectionMembers(\n          asyncResp, boost::urls::url(\"/redfish/v1/Chassis\"), chassisInterfaces,\n          \"/xyz/openbmc_project/inventory\");\n  }         \n  inline void getCollectionMembers(\n      const std::shared_ptr\u003cbmcweb::AsyncResp\u003e\u0026 asyncResp,\n      const boost::urls::url\u0026 collectionPath,\n      std::span\u003cconst std::string_view\u003e interfaces, const std::string\u0026 subtree)\n  {\n      getCollectionToKey(asyncResp, collectionPath, interfaces, subtree,\n                         nlohmann::json::json_pointer(\"/Members\"));\n  }\n  inline void getCollectionToKey(\n      const std::shared_ptr\u003cbmcweb::AsyncResp\u003e\u0026 asyncResp,\n      const boost::urls::url\u0026 collectionPath,\n      std::span\u003cconst std::string_view\u003e interfaces, const std::string\u0026 subtree,\n      const nlohmann::json::json_pointer\u0026 jsonKeyName)\n  {\n      BMCWEB_LOG_DEBUG(\"Get collection members for: {}\", collectionPath.buffer());\n      dbus::utility::getSubTreePaths(\n          subtree, 0, interfaces,\n          std::bind_front(handleCollectionMembers, asyncResp, collectionPath,\n                          jsonKeyName));\n  }\ninline void handleCollectionMembers(\n      const std::shared_ptr\u003cbmcweb::AsyncResp\u003e\u0026 asyncResp,\n      const boost::urls::url\u0026 collectionPath,\n      const nlohmann::json::json_pointer\u0026 jsonKeyName,\n      const boost::system::error_code\u0026 ec,\n      const dbus::utility::MapperGetSubTreePathsResponse\u0026 objects)\n  {\n      if (jsonKeyName.empty())\n      {\n          messages::internalError(asyncResp-\u003eres);\n          BMCWEB_LOG_ERROR(\"Json Key called empty.  Did you mean /Members?\");\n          return;\n      }\n      nlohmann::json::json_pointer jsonCountKeyName \u003d jsonKeyName;\n      std::string back \u003d jsonCountKeyName.back();\n      jsonCountKeyName.pop_back();\n      jsonCountKeyName /\u003d back + \"@odata.count\";\n  \n      if (ec \u003d\u003d boost::system::errc::io_error)\n      {\n          nlohmann::json::array_t\u0026 membersArr \u003d\n              details::getJsonArrayAt(asyncResp-\u003eres.jsonValue[jsonKeyName]);\n          asyncResp-\u003eres.jsonValue[jsonCountKeyName] \u003d membersArr.size();\n          return; \n      }                       \n  \n      if (ec)         \n      {                   \n          BMCWEB_LOG_DEBUG(\"DBUS response error {}\", ec.value());\n          messages::internalError(asyncResp-\u003eres);\n          return;         \n      }                   \n  \n      std::vector\u003cstd::string\u003e pathNames;\n      for (const auto\u0026 object : objects)      \n      {               \n          sdbusplus::object_path path(object);\n          std::string leaf \u003d path.filename();\n          if (leaf.empty())\n          {\n              continue;\n          }\n          pathNames.push_back(leaf);\n      }\n  \n      nlohmann::json::array_t\u0026 membersArr \u003d\n          details::getJsonArrayAt(asyncResp-\u003eres.jsonValue[jsonKeyName]);\n      for (const std::string\u0026 leaf : pathNames)\n      {\n          boost::urls::url url \u003d collectionPath;\n          crow::utility::appendUrlPieces(url, leaf);\n          nlohmann::json::object_t member;\n          member[\"@odata.id\"] \u003d std::move(url);\n          membersArr.emplace_back(std::move(member));\n      }   \n      json_util::sortJsonArrayByOData(membersArr);\n      asyncResp-\u003eres.jsonValue[jsonCountKeyName] \u003d membersArr.size();\n  }\n```\n\nso the leaf name is the thing that counts. Same for the systems collection.\n\ndo we need to explain the unique leaf name constraint in the patch commit message, since it seems to be the default behavior in bmcweb and not a new concept or new behavior..\n\nLet me know if i got anything wrong though.\n\ni thought we are using associations to create links. If there are no associations then no links.\n\nThe existing implementation seems wrong \n```\n  template \u003ctypename CallbackFunc\u003e\n  void getMainChassisId(const std::shared_ptr\u003cbmcweb::AsyncResp\u003e\u0026 asyncResp,\n                        CallbackFunc\u0026\u0026 callback)\n  {\n      // Find managed chassis\n      dbus::utility::getSubTree(\n          \"/xyz/openbmc_project/inventory\", 0, chassisInterfaces,\n          // ast-grep-ignore: long-lambda\n          [callback \u003d std::forward\u003cCallbackFunc\u003e(callback),\n           asyncResp](const boost::system::error_code\u0026 ec, \n                      const dbus::utility::MapperGetSubTreeResponse\u0026 subtree) {\n              if (ec)\n              {   \n                  BMCWEB_LOG_ERROR(\"{}\", ec);\n                  return;\n              }   \n              if (subtree.empty())\n              {   \n                  BMCWEB_LOG_DEBUG(\"Can\u0027t find chassis!\");\n                  return;\n              }   \n  \n              std::size_t idPos \u003d subtree[0].first.rfind(\u0027/\u0027);\n              if (idPos \u003d\u003d std::string::npos ||\n                  (idPos + 1) \u003e\u003d subtree[0].first.size())\n              {   \n                  messages::internalError(asyncResp-\u003eres);\n                  BMCWEB_LOG_DEBUG(\"Can\u0027t parse chassis ID!\");\n                  return;\n              }   \n              std::string chassisId \u003d subtree[0].first.substr(idPos + 1); \n              BMCWEB_LOG_DEBUG(\"chassisId \u003d {}\", chassisId);\n              callback(chassisId, asyncResp);\n          }); \n  }\n```\n\nand does not create any meaningful link. It just takes the first chassis it finds and links to it. Selecting some chassis at random is something the redfish client can do by itself.",
